<Window x:Class="orai_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:orai_wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="1000" Width="800">
    <Window.Resources>
        <Style TargetType="Button" x:Key="succesButton">
            <Setter Property="Background" Value="Green"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style TargetType="Button" x:Key="dangerButton">
            <Setter Property="Background" Value="Red"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style TargetType="Button" x:Key="normalButton">
            <Setter Property="Background" Value="SteelBlue"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style TargetType="TextBox" x:Key="normalTextBox">
            <Setter Property="Width" Value="250"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="AliceBlue"/>
            <Setter Property="BorderBrush" Value="SteelBlue"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="TextBox" x:Key="shortTextbox">
            <Setter Property="Width" Value=" 120"/>
            <Setter Property="Height" Value=" 35"/>
            <Setter Property="Background" Value="LightYellow"/>
            <Setter Property="BorderBrush" Value="Orange"/>
            <Setter Property="BorderThickness" Value=" 2"/>
            <Setter Property="FontSize" Value=" 16"/>
            <Setter Property="Margin" Value=" 5"/>
        </Style>

        <Style TargetType="Label" x:Key="titleLabel">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Foreground" Value="DarkBlue"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style TargetType="Label" x:Key="subTitleLabel">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="DarkSlateGray"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="Label" x:Key="warningLabel">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="Background" Value="LightYellow"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="ComboBox" x:Key="normalComboBox">
            <Setter Property="Width" Value="230"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="LightCyan"/>
            <Setter Property="BorderBrush" Value="Teal"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <Style TargetType="ComboBox" x:Key="highLightComboBox">
            <Setter Property="Width" Value="280"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Background" Value="LightYellow"/>
            <Setter Property="BorderBrush" Value="Orange"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="10"/>
        </Style>


    </Window.Resources>
    
    <StackPanel>
        <Label Content="Név: " Style="{StaticResource titleLabel}"/>
        <Label Content="Életkor: " Style="{StaticResource subTitleLabel}"/>
        <Label Content="Lakcím: " Style="{StaticResource subTitleLabel}"/>
        <Label Content="Telefoszám: " Style="{StaticResource warningLabel}"/>

        <TextBox Text="Név: " Style="{StaticResource normalTextBox}"/>
        <TextBox Text="Életkor: " Style="{StaticResource normalTextBox}"/>
        <TextBox Text="Lakcím: " Style="{StaticResource normalTextBox}"/>
        <TextBox Text="Telefonszám: " Style="{StaticResource shortTextbox}"/>

        <Button Content="Mentés" Style="{StaticResource succesButton}"/>
        <Button Content="Módosítás" Style="{StaticResource dangerButton}"/>
        <Button Content="Törlés" Style="{StaticResource normalButton}"/>
        <Button Content="Kilépés" Style="{StaticResource dangerButton}"/>

        <ComboBox Style="{StaticResource normalComboBox}">
            <ComboBoxItem Content="Python"/>
            <ComboBoxItem Content="C#"/>
            <ComboBoxItem Content="JavaScript"/>
        </ComboBox>

        <ComboBox Style="{StaticResource normalComboBox}">
            <ComboBoxItem Content="MySQL"/>
            <ComboBoxItem Content="postgre"/>
            <ComboBoxItem Content="SQLlite"/>

        </ComboBox>
        <ComboBox Style="{StaticResource highLightComboBox}">
            <ComboBoxItem Content="Kezdő"/>
            <ComboBoxItem Content="Haladó"/>
            <ComboBoxItem Content="Profi"/>

        </ComboBox>
        <ComboBox Style="{StaticResource highLightComboBox}">
            <ComboBoxItem Content="Online"/>
            <ComboBoxItem Content="Személyes"/>
            <ComboBoxItem Content="Hibris"/>

        </ComboBox>

    </StackPanel>
</Window>
