<Window x:Class="jhuuwpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:jhuuwpf"
        mc:Ignorable="d"
        Title="Formazas" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="4*"></RowDefinition>
        </Grid.RowDefinitions>
        <Label Content="assda" Background="red" Grid.Column="0" Grid.Row="1"></Label>
        <Label Content="wadsa" Background="Blue" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="4"></Label>

        <Label Content="wadsa" Background="Red"  Grid.Column="1" Grid.Row="3"></Label>
        
        <Label Content="wadsa" Background="Black"  Grid.Column="2" Grid.Row="1"></Label>
        
        <Label Content="wadsa" Background="Purple"  Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2"></Label>
        
        <Label Content="wadsa" Background="Green"  Grid.Column="1" Grid.Row="1"></Label>
        
        <Label Content="wadsa" Background="Orange"  Grid.Column="4" Grid.Row="1"></Label>
        <Label Content="wadsa" Background="Red"  Grid.Column="2" Grid.Row="3"></Label>
        <Label Content="wadsa" Background="Aqua"  Grid.Column="3" Grid.Row="3"></Label>
        
    </Grid>
</Window>
